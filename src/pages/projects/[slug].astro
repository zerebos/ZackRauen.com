---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {getGithubData} from "../../lib/github.ts";
import {getProjectEntries, type ProjectEntry} from "../../lib/projects.ts";

function formatDate(dateTime: string | Date) {
  if (!dateTime) return "";
  return new Date(dateTime).toLocaleDateString("en-US");
}

export function getStaticPaths() {
  return getProjectEntries().map((project) => ({
    params: {slug: project.slug},
    props: {project},
  }));
}

const {project} = Astro.props as {project: ProjectEntry};
const github = await getGithubData();
const repo = project.frontmatter.repo?.trim() ?? "";
const git = github.projects.find((entry) => entry.full_name === repo);
const langs = repo ? github.languages[repo] ?? {} : {};
const branches = repo ? github.branches[repo] ?? [] : [];
const Content = project.Content;
---

<BaseLayout title={`${project.frontmatter.title} | Zack Rauen`}>
  <div class="flex container splitview">
    <div class="flex flex-75 left">
      <section class="flex column project-markdown">
        <Content />
      </section>
    </div>
    <div class="flex column right">
      {repo && (
        <a class="btn btn-primary call-to-action" href={`https://github.com/${repo}`} target="_blank">
          <svg viewBox="0 0 24 24" fill="#FFFFFF">
            <path d="m12 .5c-6.63 0-12 5.28-12 11.792 0 5.211 3.438 9.63 8.205 11.188.6.111.82-.254.82-.567 0-.28-.01-1.022-.015-2.005-3.338.711-4.042-1.582-4.042-1.582-.546-1.361-1.335-1.725-1.335-1.725-1.087-.731.084-.716.084-.716 1.205.082 1.838 1.215 1.838 1.215 1.07 1.803 2.809 1.282 3.495.981.108-.763.417-1.282.76-1.577-2.665-.295-5.466-1.309-5.466-5.827 0-1.287.465-2.339 1.235-3.164-.135-.298-.54-1.497.105-3.121 0 0 1.005-.316 3.3 1.209.96-.262 1.98-.392 3-.398 1.02.006 2.04.136 3 .398 2.28-1.525 3.285-1.209 3.285-1.209.645 1.624.24 2.823.12 3.121.765.825 1.23 1.877 1.23 3.164 0 4.53-2.805 5.527-5.475 5.817.42.354.81 1.077.81 2.182 0 1.578-.015 2.846-.015 3.229 0 .309.21.678.825.56 4.801-1.548 8.236-5.97 8.236-11.173 0-6.512-5.373-11.792-12-11.792z"></path>
          </svg>
          View on GitHub!
        </a>
      )}
      <section class="flex column project-sidebar">
        <h2>Stats</h2>
        <ul class="stats">
          {git?.license?.name && (
            <li><svg xmlns="http://www.w3.org/2000/svg" enable-background="new 0 0 24 24" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><g><rect fill="none" height="24" width="24" x="0"></rect></g><g><g><rect height="20" transform="matrix(0.7075 -0.7067 0.7067 0.7075 -5.6854 13.7194)" width="4" x="11.73" y="3.73"></rect><rect height="8" transform="matrix(0.707 -0.7072 0.7072 0.707 0.3157 11.246)" width="4" x="11.73" y="1.24"></rect><rect height="8" transform="matrix(0.7071 -0.7071 0.7071 0.7071 -8.1722 7.7256)" width="4" x="3.24" y="9.73"></rect><rect height="2" width="12" x="1" y="21"></rect></g></g></svg><a href={`https://github.com/${repo}/blob/${git.default_branch}/LICENSE`} target="_blank">{git.license.name}</a></li>
          )}
          {git && <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"></path><path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"></path></svg><a href={`https://github.com/${repo}/commits/`} target="_blank">{formatDate(git.pushed_at)}</a></li>}
          {git && <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M0 0h24v24H0z" fill="none"></path><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><a href={`https://github.com/${repo}/stargazers/`} target="_blank">{git.stargazers_count} Stars</a></li>}
          {git && <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"></path></svg><a href={`https://github.com/${repo}/watchers/`} target="_blank">{git.subscribers_count} Watchers</a></li>}
          {git && <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M0 0h24v24H0V0z" fill="none"></path><path d="M17 16l-4-4V8.82C14.16 8.4 15 7.3 15 6c0-1.66-1.34-3-3-3S9 4.34 9 6c0 1.3.84 2.4 2 2.82V12l-4 4H3v5h5v-3.05l4-4.2 4 4.2V21h5v-5h-4z"></path></svg><a href={`https://github.com/${repo}/network/members/`} target="_blank">{git.forks} Forks</a></li>}
          {git && <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M20 8h-2.81c-.45-.78-1.07-1.45-1.82-1.96L17 4.41 15.59 3l-2.17 2.17C12.96 5.06 12.49 5 12 5c-.49 0-.96.06-1.41.17L8.41 3 7 4.41l1.62 1.63C7.88 6.55 7.26 7.22 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H20v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-6 8h-4v-2h4v2zm0-4h-4v-2h4v2z"></path></svg><a href={`https://github.com/${repo}/issues/`} target="_blank">{git.open_issues_count} Issues</a></li>}
        </ul>
      </section>
      <section class="flex column project-sidebar">
        <h2>Languages</h2>
        <ul class="stats">
          {Object.entries(langs).map(([lang, percent]) => (
            <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0V0z" fill="none"></path><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"></path></svg><a href={`https://github.com/${repo}/search?l=${lang.toLowerCase()}`} target="_blank">{lang}</a>&mdash; {percent}%</li>
          ))}
        </ul>
      </section>
      <section class="flex column project-sidebar">
        <h2>Branches</h2>
        <ul class="stats">
          {git && <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M14 4l2.29 2.29-2.88 2.88 1.42 1.42 2.88-2.88L20 10V4zm-4 0H4v6l2.29-2.29 4.71 4.7V20h2v-8.41l-5.29-5.3z"></path></svg><a href={`https://github.com/${repo}`} target="_blank" title={git.default_branch}>{git.default_branch}</a>&mdash; default</li>}
          {branches.filter((branch) => branch !== git?.default_branch).map((branch) => (
            <li><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#FFFFFF"><path d="M0 0h24v24H0z" fill="none"></path><path d="M14 4l2.29 2.29-2.88 2.88 1.42 1.42 2.88-2.88L20 10V4zm-4 0H4v6l2.29-2.29 4.71 4.7V20h2v-8.41l-5.29-5.3z"></path></svg><a href={`https://github.com/${repo}/blob/${branch}`} target="_blank" title={branch}>{branch}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
