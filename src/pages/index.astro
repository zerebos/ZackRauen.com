---
import {getCollection} from "astro:content";
import Base from "../layouts/Base.astro";
import Socials from "../components/Socials.astro";
import github from "../data/github";
import about from "../data/about";
import socials from "../data/socials";
import experience from "../data/resume/experience";
import resumeProjects from "../data/resume/projects";
import skills from "../data/resume/skills";
import education from "../data/resume/education";
import awards from "../data/resume/awards";
import publications from "../data/resume/publications";

const stats = await github();
const aboutFields = Object.entries(about.fields);
const projects = (await getCollection("projects")).sort((a, b) => a.id.localeCompare(b.id));

// Circumference of the meter circle (2 * PI * r, r = 40) rounded to the value the CSS uses.
const METER_CIRCUMFERENCE = 255;
const dashOffset = (percent: number) => METER_CIRCUMFERENCE - (percent / 100) * METER_CIRCUMFERENCE;
---

<Base>
    <section class="fullscreen" id="home">
        <div class="container">
            <div class="title">
                <h3>Hey there! I'm</h3>
                <h1>Zack Rauen</h1>
                <h2>And I'm <span id="jobtitle">an Engineer</span></h2>
                <div class="content">
                    <div class="stat">
                        <div class="label">Repos</div>
                        <div class="value">{stats.count}</div>
                    </div>
                    <div class="stat">
                        <div class="label">Stars</div>
                        <div class="value">{stats.stars}</div>
                    </div>
                    <div class="stat">
                        <div class="label">Issues</div>
                        <div class="value">{stats.issues}</div>
                    </div>
                </div>
            </div>
            <a class="btn btn-primary btn-fab" href="#about" aria-label="Scroll Down!">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path d="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z"/></svg>
            </a>
        </div>
    </section>

    <section class="flex container half-padded" id="about">
        <div class="flex column">
            <div class="flex">
                <div class="flex flex-50 animate-on-scroll fade-up"><img id="myuglymug" src="/assets/images/myuglymug.webp" alt="Picture of me" /></div>
                <div class="flex column flex-50 content-pad animate-on-scroll fade-up">
                    <div class="flex column">
                        <h2>About Me</h2>
                        <p>{about.blurb}</p>
                        <ul class="about-info">
                            {aboutFields.map(([label, value]) => (
                                <li><span class="label">{label}</span> <span>{value}</span></li>
                            ))}
                        </ul>
                    </div>
                    <a href="/assets/resume.pdf" class="btn btn-primary" download>Download CV</a>
                </div>
            </div>
            <Socials />
        </div>
    </section>

    <section class="flex container padded" id="resume">
        <div class="flex-25 resume-nav-wrap">
            <nav id="resume-nav">
                <ul>
                    <li><a href="#experience">Experience</a></li>
                    <li><a href="#resume-projects">Projects</a></li>
                    <li><a href="#skills">Technical Skills</a></li>
                    <li><a href="#education">Education</a></li>
                    <li><a href="#awards">Awards</a></li>
                    <li><a href="#publications">Publications</a></li>
                </ul>
            </nav>
        </div>
        <div class="flex-75">
            <div id="experience" class="resume-section">
                <h2 class="heading animate-on-scroll fade-up">Professional Experience</h2>
                {experience.map(exp => (
                    <div class="resume-entry">
                        <div class="resume-icon experience"></div>
                        <div class="resume-info">
                            <span class="date">{exp.start} - {exp.end}</span>
                            <h2>{exp.title} <span class="company">@{exp.company}</span></h2>
                            <ul>
                                {exp.highlights.map(highlight => <li>{highlight}</li>)}
                            </ul>
                        </div>
                    </div>
                ))}
            </div>
            <div id="resume-projects" class="resume-section">
                <h2 class="heading animate-on-scroll fade-up">Projects</h2>
                {resumeProjects.map(project => (
                    <div class="resume-entry">
                        <div class="resume-icon experience"></div>
                        <div class="resume-info">
                            <span class="date">{project.type}</span>
                            <h2>{project.title}</h2>
                            <p>{project.blurb}</p>
                            {(project.slug || project.github) && (
                                <div class="resume-footer">
                                    {project.github && (
                                        <a class="btn btn-primary" href={`https://github.com/${project.github}`} target="_blank">
                                            <svg viewBox="0 0 24 24" fill="#FFFFFF">
                                                <path d="m12 .5c-6.63 0-12 5.28-12 11.792 0 5.211 3.438 9.63 8.205 11.188.6.111.82-.254.82-.567 0-.28-.01-1.022-.015-2.005-3.338.711-4.042-1.582-4.042-1.582-.546-1.361-1.335-1.725-1.335-1.725-1.087-.731.084-.716.084-.716 1.205.082 1.838 1.215 1.838 1.215 1.07 1.803 2.809 1.282 3.495.981.108-.763.417-1.282.76-1.577-2.665-.295-5.466-1.309-5.466-5.827 0-1.287.465-2.339 1.235-3.164-.135-.298-.54-1.497.105-3.121 0 0 1.005-.316 3.3 1.209.96-.262 1.98-.392 3-.398 1.02.006 2.04.136 3 .398 2.28-1.525 3.285-1.209 3.285-1.209.645 1.624.24 2.823.12 3.121.765.825 1.23 1.877 1.23 3.164 0 4.53-2.805 5.527-5.475 5.817.42.354.81 1.077.81 2.182 0 1.578-.015 2.846-.015 3.229 0 .309.21.678.825.56 4.801-1.548 8.236-5.97 8.236-11.173 0-6.512-5.373-11.792-12-11.792z" />
                                            </svg>
                                            View on GitHub!
                                        </a>
                                    )}
                                    {project.slug && (
                                        <a href={project.slug} class="btn">
                                            Read More <svg xmlns="http://www.w3.org/2000/svg" enable-background="new 0 0 24 24" height="24px" viewBox="0 0 24 24" width="24px" fill="currentColor"><g><rect fill="none" height="24" width="24"/></g><g><polygon points="6,6 6,8 14.59,8 5,17.59 6.41,19 16,9.41 16,18 18,18 18,6"/></g></svg>
                                        </a>
                                    )}
                                </div>
                            )}
                        </div>
                    </div>
                ))}
            </div>
            <div id="skills" class="resume-section">
                <h2 class="heading animate-on-scroll fade-up">Technical Skills</h2>
                <div class="flex showcase">
                    {skills.meters.map(skill => (
                        <div class="flex flex-justify column flex-33 animate-on-scroll fade-up">
                            <div class="tile">
                                <h2>{skill.label}</h2>
                                <div class="meter">
                                    <h2>{skill.value}%</h2>
                                    <svg class="graph" viewBox="0 0 100 100">
                                        <circle cx="50" cy="50" r="40" stroke="#ccc" stroke-width="4" class="bar" />
                                        <circle cx="50" cy="50" r="40" stroke="#428bca" stroke-width="4" class="fill" style={`stroke-dashoffset: ${dashOffset(skill.value)};`} />
                                    </svg>
                                </div>
                                <div class="flex details">
                                    {skill.subskills.map(subskill => (
                                        <div class="flex-50">
                                            <span class="subskill">{subskill.value}%</span><span class="small text-gray">{subskill.label}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
                <div class="flex flex-wrap">
                    {skills.bars.map(skill => (
                        <div class="progress animate-on-scroll fade-up">
                            <div class="progress-info"><h3>{skill.label}</h3><span>{skill.value}%</span></div>
                            <div class="progress-bar"><div class="progress-fill" style={`width: ${skill.value}%`}></div></div>
                        </div>
                    ))}
                </div>
            </div>
            <div id="education" class="resume-section">
                <h2 class="heading animate-on-scroll fade-up">Education</h2>
                {education.map(edu => (
                    <div class="resume-entry">
                        <div class="resume-icon education"></div>
                        <div class="resume-info">
                            <span class="date">{edu.school} &mdash; {edu.start} - {edu.end}</span>
                            <h2>{edu.degree}</h2>
                            <p>{edu.blurb}</p>
                        </div>
                    </div>
                ))}
            </div>
            <div id="awards" class="resume-section">
                <h2 class="heading animate-on-scroll fade-up">Awards</h2>
                {awards.map(award => (
                    <div class="resume-entry">
                        <div class="resume-icon award"></div>
                        <div class="resume-info">
                            <span class="date">{award.date}</span>
                            <h2>{award.name}</h2>
                            <p>{award.blurb}</p>
                        </div>
                    </div>
                ))}
            </div>
            <div id="publications" class="resume-section">
                <h2 class="heading animate-on-scroll fade-up">Publications</h2>
                {publications.map(pub => (
                    <div class="resume-entry">
                        <div class="resume-icon publication"></div>
                        <div class="resume-info">
                            <span class="date">{pub.journal} &mdash; {pub.date}</span>
                            <h2>{pub.title}</h2>
                            <p>{pub.authors}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="flex container column padded" id="projects">
        <div class="flex container column heading animate-on-scroll fade-up">
            <h2>Deep Dives</h2>
            <p>A deeper look and retrospective on my past work. More can be found on my <a href="https://github.com/zerebos" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
        </div>
        <div class="flex flex-wrap">
            {projects.map(project => (
                <div class="flex flex-33 project animate-on-scroll fade-up">
                    <a href={`/projects/${project.id}`} class="wrapper">
                        <img src={`/assets/projects/icons/${project.data.icon}`} class="icon" alt={project.data.title} />
                        <div class="info">
                            <h3>{project.data.title}</h3>
                            <p>{project.data.blurb}</p>
                        </div>
                    </a>
                </div>
            ))}
        </div>
    </section>

    <section class="flex container half-padded" id="contact">
        <div class="flex flex-50 column heading animate-on-scroll fade-up">
            <h2>Contact Me</h2>
            <p>Always open to engineering discussions, open source work, and meaningful collaboration with anyone building cool things!</p>
            <img src="/assets/images/contact.webp" class="contact-avatar" alt="Picture of me">
            <p>You can also reach out on <a href={socials.LinkedIn} target="_blank">LinkedIn</a>.</p>
        </div>
        <form action="https://api.staticforms.xyz/submit" method="post" id="contactform" class="flex flex-50 column animate-on-scroll fade-up">
            <label for="name">Name</label>
            <input class="text-input" type="text" name="name" placeholder="John Smith" required>
            <label for="filter" id="captcha-wrap">Spam Filter <canvas id="captcha"></canvas></label>
            <input class="text-input" type="text" name="filter" placeholder="Spam Filter" required>
            <label for="email">Email</label>
            <input class="text-input" type="email" name="email" placeholder="jsmith@bigcompany.com" required>
            <label for="subject">Subject</label>
            <input class="text-input" type="text" name="subject" placeholder="I want to hire you!" required>
            <label for="message">Message</label>
            <textarea class="text-input" name="message" cols="20" rows="7" placeholder="I have a great job opportunity for you..." required></textarea>
            <button class="btn btn-primary" type="submit">Send Message</button>
        </form>
    </section>

    <script>
        import "../scripts/jobtitle.ts";
        import "../scripts/contact.ts";
    </script>
</Base>
